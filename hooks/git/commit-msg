#!/bin/sh
# what: strip every Claude/AI signature from a commit message before the commit
#       is finalized. Covers Co-Authored-By trailers, Claude-Session links, and
#       "Generated with Claude Code" advertising lines.
#
# why:  the git-commit skill tells Claude never to add one, and
#       "includeCoAuthoredBy": false in settings.json is a second, harness-level
#       layer — but both are Claude Code's own compliance, unverifiable from
#       outside a closed binary and only in effect for a session started after
#       they were set. This is a THIRD, independent layer: a real git hook,
#       triggered by `git commit` itself, not by Claude Code's hook system at
#       all. It catches every commit from every source (any Claude session, a
#       stale build that predates the setting, a human, a future tool), and its
#       correctness can be read from this file and tested with two commands.
#
#       The third layer is not paranoia, it is the layer that was missing. On
#       2026-09-03 a commit landed in dotclaude carrying
#       "Claude-Session: https://claude.ai/code/session_...", because the
#       HARNESS ITSELF injects a system-reminder instructing the session to
#       append that trailer. Skill rules and settings both lost to an
#       instruction delivered at runtime; this hook does not lose, because it
#       runs after the message is written and does not negotiate. Any future
#       signature form will arrive the same way, which is why the pattern below
#       is a list to extend rather than a single trailer name.
#
# how:  $1 is the path git hands every commit-msg hook: the message file, about
#       to become the commit object. Editing it here IS editing the commit,
#       before it exists — this fires DURING `git commit`, so there is no
#       instant where a commit carrying a signature exists in the object store.
#
# scope: strips ANY "Co-Authored-By:" line, matching the git-commit skill's
#        rule verbatim ("NEVER include ... trailers", no carve-out for a real
#        human co-author), plus the Claude-Session trailer, any bare
#        claude.ai/code/session URL, and the "Generated with Claude Code"
#        line and its robot emoji. Add new forms to SIGNATURE_RE.
#
# portable on purpose: grep + awk + mv, no `sed -i` (GNU and BSD sed take the
# backup-suffix argument differently) and no jq/python3 dependency, so the
# SAME file works unmodified on the Linux DSW boxes and on macOS. Wired up
# via `core.hooksPath`, not by copying into every repo's .git/hooks/.

SIGNATURE_RE='^Co-Authored-By:|^Claude-Session:|claude\.ai/code/session|Generated with \[?Claude|^[[:space:]]*🤖'

grep -qiE "$SIGNATURE_RE" "$1" || exit 0

# Drop the signature lines, then drop the blank lines they left stranded at the
# end. A trailer block is preceded by a blank separator line, so removing the
# trailer without this leaves a message ending in whitespace.
grep -viE "$SIGNATURE_RE" "$1" \
  | awk '{ line[NR] = $0 }
         END { last = 0
               for (i = 1; i <= NR; i++) if (line[i] ~ /[^ \t]/) last = i
               for (i = 1; i <= last; i++) print line[i] }' > "$1.tmp" \
  && mv "$1.tmp" "$1"

echo "commit-msg hook: stripped a Claude/AI signature from the commit message" >&2
exit 0
